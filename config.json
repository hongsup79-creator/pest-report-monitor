{
  "_note": "모니터링 범위 설정 파일. 작물·저널·키워드를 여기서 추가/수정하면 수집 범위가 바뀝니다.",

  "crops": {
    "벼":   ["rice", "oryza sativa", "oryza", "paddy"],
    "밀":   ["wheat", "triticum aestivum", "triticum", "durum"],
    "보리": ["barley", "hordeum vulgare", "hordeum"]
  },

  "crossref_journals": {
    "Plant Disease":                   ["0191-2917", "1943-7692"],
    "New Disease Reports":             ["2044-0588"],
    "Plant Pathology":                 ["0032-0862", "1365-3059"],
    "Journal of Plant Pathology":      ["1125-4718", "2239-7264"],
    "European Journal of Plant Pathology": ["0929-1873", "1573-8469"],
    "Journal of Phytopathology":       ["0931-1785", "1439-0434"],
    "Australasian Plant Disease Notes": ["1833-928X"],
    "The Plant Pathology Journal":     ["1598-2254", "2093-9280"],
    "Plant Health Progress":           ["1535-1025"]
  },

  "pubmed_query": "(rice[tiab] OR Oryza[tiab] OR wheat[tiab] OR Triticum[tiab] OR barley[tiab] OR Hordeum[tiab]) AND (\"first report\"[tiab] OR \"new disease\"[tiab] OR \"seed-borne\"[tiab] OR seedborne[tiab] OR \"seed transmission\"[tiab] OR \"seed-transmitted\"[tiab])",

  "first_report_patterns": [
    "\\bfirst reports?\\b",
    "\\bfirst (?:record|detection|occurrence|identification)\\b",
    "\\bnew (?:disease|pathogen|record)s?\\b",
    "\\bnew (?:alternate |alternative |natural )?hosts?\\b",
    "\\bnew reservoirs?\\b",
    "\\bnewly (?:reported|recorded|emerging|identified)\\b",
    "\\bemerging (?:disease|pathogen|risk|threat)s?\\b",
    "\\bemergence of\\b",
    "^report on\\b"
  ],

  "_note_occurrence": "제목이 아래 표현으로 시작하고 국가가 명시되면 발생보고로 판정 (예: Molecular Detection of ... in Ecuador)",
  "occurrence_start_patterns": [
    "^(?:molecular |first )?(?:detection|identification|occurrence|characteri[sz]ation)\\b"
  ],

  "_note_seed_title": "제목에만 적용하는 종자 표현 (초록에 적용하면 범위가 지나치게 넓어짐)",
  "seed_title_patterns": [
    "\\bseeds?\\b",
    "\\bseed treatments?\\b"
  ],

  "seed_patterns": [
    "\\bseed[- ]?borne\\b",
    "\\bseed[- ]?transmi",
    "\\bseed[- ]?transmitted\\b",
    "\\bseed lots?\\b",
    "\\bseed health\\b",
    "\\bseed (?:infection|contamination)\\b"
  ],

  "exclude_patterns": [
    "^(?:corrigendum|erratum|correction|retraction|retracted)\\b",
    "\\brice ?fish\\b",
    "\\boryzias\\b"
  ],

  "pathogen_genera": [
